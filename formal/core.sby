# Bitwuzla, because it is several times faster than yices here: prove 23 s against 97, and latency
# 90 s against more than an hour. z3 was slower still.
#
# The prove tasks are unbounded: k-induction over the invariants in core_invariants.svh, which hold in
# every reachable state. They cover the pipeline with every cache signal free, F and I/O included, at
# two sizes: 16 cells in lines of 4 with strides up to 3, and lines of 8 with strides up to 7, so that
# a backward scan has lines to go wrong in and the tables have strides to get wrong. prove and
# prove_lines replace the 8 x 8 multiplier with an XOR on both sides, which the solver finds far
# easier; prove_multiplier keeps the real one.
#
# latency is bounded: without F and I/O, every instruction retires within a fixed number of cycles,
# which an induction would need its own invariants for. cover shows that every kind of retire is
# reachable, so that the proofs are not vacuous.
[tasks]
prove
prove_lines
prove_multiplier
latency
cover

[options]
# A run that has not finished in an hour is not going to: each BMC step takes two to three times as
# long as the one before. sby stops its solvers itself and reports TIMEOUT.
timeout 3600
prove: mode prove
prove: depth 3
prove_lines: mode prove
prove_lines: depth 3
prove_multiplier: mode prove
prove_multiplier: depth 3
latency: mode bmc
latency: depth 28
cover: mode cover
cover: depth 40

[engines]
smtbmc --nopresat bitwuzla

[script]
prove: read -formal -sv -DFORMAL -DFORMAL_ABSTRACT_MUL -DFORMAL_INVARIANTS brainfunk_core.sv
prove_lines: read -formal -sv -DFORMAL -DFORMAL_ABSTRACT_MUL -DFORMAL_INVARIANTS brainfunk_core.sv
prove_multiplier: read -formal -sv -DFORMAL -DFORMAL_INVARIANTS brainfunk_core.sv
latency: read -formal -sv -DFORMAL -DFORMAL_ABSTRACT_MUL -DBOUNDED_LATENCY brainfunk_core.sv
cover: read -formal -sv -DFORMAL brainfunk_core.sv
prove: chparam -set PC_WIDTH 5 -set ADDR_WIDTH 4 -set LINE_BITS 2 -set STRIDE_BITS 2 brainfunk_core
prove_lines: chparam -set PC_WIDTH 5 -set ADDR_WIDTH 4 -set LINE_BITS 3 -set STRIDE_BITS 3 brainfunk_core
prove_multiplier: chparam -set PC_WIDTH 5 -set ADDR_WIDTH 4 -set LINE_BITS 2 -set STRIDE_BITS 2 brainfunk_core
latency: chparam -set PC_WIDTH 5 -set ADDR_WIDTH 3 -set LINE_BITS 2 -set STRIDE_BITS 2 brainfunk_core
cover: chparam -set PC_WIDTH 5 -set ADDR_WIDTH 3 -set LINE_BITS 2 -set STRIDE_BITS 2 brainfunk_core
prep -top brainfunk_core

[files]
../rtl/brainfunk_core.sv
core_props.svh
core_invariants.svh
