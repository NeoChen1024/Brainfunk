# bmc and bmc_miss replace the 8 x 8 multiplier with an XOR on both sides of the check, because the
# multiplier is what the solver spends most of its time on; multiplier keeps the real one. With the
# cache signals free the search grows quickly, so bmc assumes every access hits and goes deepest,
# and bmc_miss leaves them free.
[tasks]
bmc
bmc_miss
multiplier
latency
cover

[options]
bmc: mode bmc
bmc: depth 32
bmc_miss: mode bmc
bmc_miss: depth 22
multiplier: mode bmc
multiplier: depth 15
latency: mode bmc
latency: depth 28
cover: mode cover
cover: depth 40

[engines]
smtbmc --nopresat yices

[script]
multiplier: read -formal -sv -DFORMAL brainfunk_core.sv
bmc: read -formal -sv -DFORMAL -DFORMAL_ABSTRACT_MUL -DNO_MISSES brainfunk_core.sv
bmc_miss: read -formal -sv -DFORMAL -DFORMAL_ABSTRACT_MUL brainfunk_core.sv
latency: read -formal -sv -DFORMAL -DFORMAL_ABSTRACT_MUL -DBOUNDED_LATENCY brainfunk_core.sv
cover: read -formal -sv -DFORMAL brainfunk_core.sv
chparam -set PC_WIDTH 5 -set ADDR_WIDTH 3 -set LINE_BITS 2 -set STRIDE_BITS 2 brainfunk_core
prep -top brainfunk_core

[files]
../rtl/brainfunk_core.sv
core_props.svh
